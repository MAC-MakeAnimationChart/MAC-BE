# Tracked example. Copy to application-local.yml (gitignored) and set your password.
# Local development: installed MySQL, root account, existing mac database; no Docker.
# Both development and production databases will move to RDS later; local mac is used now.
spring:
  datasource:
    url: "jdbc:mysql://localhost:3306/mac?connectionTimeZone=UTC"
    username: root
    password: ""
  flyway:
    # Review/apply the schema separately. Creating mac does not create entity tables.
    enabled: false
  mail:
    # SMTP 제공사에 맞게 환경 변수로 설정한다. 실제 비밀번호는 Git에 넣지 않는다.
    host: ${MAIL_HOST:localhost}
    port: ${MAIL_PORT:587}
    username: ${MAIL_USERNAME:}
    password: ${MAIL_PASSWORD:}
    properties:
      mail.smtp.auth: ${MAIL_SMTP_AUTH:true}
      mail.smtp.starttls.enable: ${MAIL_STARTTLS:true}
      mail.smtp.starttls.required: ${MAIL_STARTTLS:true}
      mail.smtp.connectiontimeout: 5000
      mail.smtp.timeout: 5000
      mail.smtp.writetimeout: 5000
app:
  auth:
    # 제공사 콘솔의 Web client와 callback 설정. 실제 값은 개인 local 파일/환경 변수에만 둔다.
    social:
      google:
        client-id: ${GOOGLE_OAUTH_CLIENT_ID:}
        client-secret: ${GOOGLE_OAUTH_CLIENT_SECRET:}
        redirect-uris: ${GOOGLE_OAUTH_REDIRECT_URIS:http://localhost:3000/auth/callback/google}
      kakao:
        client-id: ${KAKAO_OAUTH_CLIENT_ID:}
        client-secret: ${KAKAO_OAUTH_CLIENT_SECRET:}
        redirect-uris: ${KAKAO_OAUTH_REDIRECT_URIS:http://localhost:3000/auth/callback/kakao}
      naver:
        client-id: ${NAVER_OAUTH_CLIENT_ID:}
        client-secret: ${NAVER_OAUTH_CLIENT_SECRET:}
        redirect-uris: ${NAVER_OAUTH_REDIRECT_URIS:http://localhost:3000/auth/callback/naver}
    # JWT 키와 별개의 32바이트 이상 난수 Base64. 미설정 시 코드 발송을 거절한다.
    hmac-secret-base64: ${AUTH_HMAC_SECRET_BASE64:}
    mail-from: ${MAIL_FROM:}
    policy:
      # localhost HTTP 개발용. 운영 HTTPS에서는 true로 설정한다.
      secure-cookie: false
springdoc:
  api-docs:
    enabled: true
  swagger-ui:
    enabled: true
