# Reference only. Spring does NOT load this file automatically.
# Set these in IntelliJ Run Configuration or the process environment.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
# DB credentials belong in the gitignored application-local.yml.
# Base64 of at least 32 cryptographically random bytes. Never commit the real key.
JWT_SECRET_BASE64=
JWT_ISSUER=mac-studio
JWT_AUDIENCE=mac-studio-api
CORS_ALLOWED_ORIGINS=http://localhost:3000
S3_ENABLED=false
S3_BUCKET=
AWS_REGION=ap-northeast-2
AWS_PROFILE=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
